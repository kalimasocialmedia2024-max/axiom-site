---
// الشعار: صورة الاسم من public/brand/logo.png مقسومة جزأين لتُبعَد علامة + قليلاً عن الاسم،
// والعبارة "إعلام بمستوى الحقيقة" نصّ حقيقي تحتها. إن غاب الملفّ يظهر الاسم نصّاً.
import { BRAND } from '../lib/brand.js';
import { SITE } from '../lib/config.js';
const { small = false } = Astro.props;
---
<span class="logo">
  {BRAND.logo
    ? <>
        <span class="mark-split" role="img" aria-label={`${SITE.name}: ${SITE.slogan}`} style={small ? '--h:30px' : undefined}><span class="ms-a"></span><span class="ms-b"></span></span>
        <span class="slogan-text" aria-hidden="true">{SITE.slogan}</span>
      </>
    : <span class="fallback" dir="ltr">{SITE.name}</span>}
</span>
