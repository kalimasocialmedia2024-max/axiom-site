---
// بطاقة مادّة في الشبكات (صورة، تصنيف، عنوان، مقتطف، كاتب).
import Img from './Img.astro';
import { articleUrl, KINDS, sectionTitle } from '../lib/config.js';
import { fmtDate, authorNames } from '../lib/format.js';
const { a, excerpt = false, showTag = true, showAuthor = false, showDate = false, ratio = 'r32' } = Astro.props;
const tag = a.kind === 'news' ? sectionTitle(a.section) || KINDS.news.badge : KINDS[a.kind]?.badge;
---
<article class="card">
  <a href={articleUrl(a)} tabindex="-1" aria-hidden="true"><Img src={a.image?.url} alt={a.image?.alt || ''} ratio={ratio} /></a>
  {showTag && tag && <span class="tag" style="font-size:12px">{tag}</span>}
  <h3><a href={articleUrl(a)}>{a.title}</a></h3>
  {excerpt && a.excerpt && <p>{a.excerpt}</p>}
  {(showAuthor || showDate) && (
    <span class="meta">{[showAuthor && authorNames(a), showDate && fmtDate(a.publishedAt)].filter(Boolean).join(' · ')}</span>
  )}
</article>
