---
import Base from '../layouts/Base.astro';
---
<Base title="الصفحة غير موجودة">
  <main class="wrap" style="padding-block:96px;text-align:center;display:flex;flex-direction:column;gap:16px;align-items:center">
    <h1 class="kufi" style="margin:0;font-weight:800;font-size:36px">الصفحة غير موجودة</h1>
    <p style="margin:0;color:var(--ink2)">ربّما نُقلت المادّة أو تغيّر رابطها.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
      <a class="btn red" href="/">الصفحة الرئيسية</a>
      <a class="btn" href="/search/">بحث</a>
    </div>
  </main>
</Base>
