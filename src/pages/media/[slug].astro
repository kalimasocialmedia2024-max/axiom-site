---
import Base from '../../layouts/Base.astro';
import Share from '../../components/Share.astro';
import { getData } from '../../lib/sanity.js';
import { MEDIA_TYPES } from '../../lib/config.js';
import { fmtDate } from '../../lib/format.js';
import { youtubeId } from '../../lib/portableText.js';

const dec = (v) => { try { return decodeURIComponent(v || ''); } catch { return v || ''; } };
const data = await getData();
const e = data.episodes.find((x) => x.slug === Astro.params.slug || x.slug === dec(Astro.params.slug));
if (!e) return Astro.rewrite('/404');
const yt = youtubeId(e.youtubeUrl);
---
<Base title={e.title} description={e.description} image={e.cover} active="/media/">
  <section class="dark-band">
    <div class="wrap" style="padding-block:40px;display:flex;flex-direction:column;gap:20px;max-width:1000px">
      <nav class="crumbs sub" aria-label="مسار التصفّح"><a href="/">الرئيسية</a><span aria-hidden="true">›</span><a href={`/media/?type=${e.mediaType}`}>{MEDIA_TYPES[e.mediaType]}</a></nav>
      {yt && <div class="embed"><iframe src={`https://www.youtube-nocookie.com/embed/${yt}`} title={e.title} allowfullscreen></iframe></div>}
      {e.audio && <audio src={e.audio} controls preload="metadata" style="width:100%"></audio>}
      <span class="badge">{MEDIA_TYPES[e.mediaType]}</span>
      <h1 class="kufi" style="margin:0;font-weight:800;font-size:32px;line-height:1.5">{e.title}</h1>
      <span class="sub" style="font-size:15px">{[e.program?.title, e.guest && `الضيف: ${e.guest}`, e.duration, fmtDate(e.publishedAt)].filter(Boolean).join(' · ')}</span>
      {e.description && <p style="margin:0;font-size:17px;line-height:1.9;color:#EDEDF0">{e.description}</p>}
    </div>
  </section>
  <article class="narrow">
    <Share title={e.title} />
    {e.transcript && (
      <section id="transcript" style="display:flex;flex-direction:column;gap:12px">
        <h2 class="kufi" style="margin:0;font-weight:800;font-size:22px">النصّ المكتوب</h2>
        {e.transcript.split(/\n+/).map((para) => <p class="prose-p">{para}</p>)}
      </section>
    )}
  </article>
</Base>
