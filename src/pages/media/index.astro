---
import ComingSoon from '../../components/ComingSoon.astro';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { getData } from '../../lib/sanity.js';
import { MEDIA_TYPES } from '../../lib/config.js';
import { fmtDate } from '../../lib/format.js';

const data = await getData();
const eps = data.episodes;
const latest = eps.find((e) => e.mediaType !== 'audio') || eps[0];
const audio = eps.filter((e) => e.mediaType === 'audio').slice(0, 8);
const play = (s) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>`;
---
<Base title="بودكاست وفيديو" description="بودكاست AXIOM+ وفيديوهاتها ونشرتها الصوتية" active="/media/">
  <section class="dark-band">
    <div class="wrap" style="padding-block:40px;display:flex;flex-direction:column;gap:28px">
      <div class="pills" role="group" aria-label="نوع المحتوى">
        <button type="button" class="pill on" data-mt="">الكلّ</button>
        {Object.entries(MEDIA_TYPES).map(([k, v]) => <button type="button" class="pill" data-mt={k}>{v}</button>)}
      </div>
      {latest ? (
        <div style="display:flex;flex-wrap:wrap;gap:32px;align-items:center">
          <a href={`/media/${latest.slug}/`} class="thumb" style="flex:3 1 560px" aria-label={latest.title}>
            <Img src={latest.cover} alt="" ratio="r169" w={1200} label="" />
            <span class="play" style="width:80px;height:80px" set:html={play(32)}></span>
          </a>
          <div style="flex:2 1 320px;display:flex;flex-direction:column;gap:12px">
            <span class="badge">الحلقة الأحدث</span>
            <h1 class="kufi" style="margin:0;font-weight:800;font-size:32px;line-height:1.5"><a href={`/media/${latest.slug}/`}>{latest.title}</a></h1>
            <span class="sub" style="font-size:15px">{[latest.program?.title, latest.guest && `الضيف: ${latest.guest}`, latest.duration].filter(Boolean).join(' · ')}</span>
            {latest.description && <p style="margin:0;font-size:16px;line-height:1.9;color:#EDEDF0">{latest.description}</p>}
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
              {(latest.youtubeUrl || latest.spotifyUrl || latest.appleUrl) && <span class="sub" style="font-size:13px">استمع على</span>}
              {latest.youtubeUrl && <a href={latest.youtubeUrl} target="_blank" rel="noopener" style="border:1px solid #4A4A52;border-radius:18px;padding:6px 14px;font-size:13px">يوتيوب</a>}
              {latest.spotifyUrl && <a href={latest.spotifyUrl} target="_blank" rel="noopener" style="border:1px solid #4A4A52;border-radius:18px;padding:6px 14px;font-size:13px">سبوتيفاي</a>}
              {latest.appleUrl && <a href={latest.appleUrl} target="_blank" rel="noopener" style="border:1px solid #4A4A52;border-radius:18px;padding:6px 14px;font-size:13px">أبل بودكاست</a>}
            </div>
          </div>
        </div>
      ) : <p class="sub">لا حلقات منشورة بعد.</p>}
    </div>
  </section>
  <section class="dark-band deep">
    <div class="wrap" style="padding-block:40px;display:flex;flex-direction:column;gap:22px">
      <h2 class="kufi" style="margin:0;font-weight:800;font-size:24px">أحدث الحلقات</h2>
      <div class="grid" id="eps">
        {eps.map((e) => (
          <a href={`/media/${e.slug}/`} data-type={e.mediaType} style="display:flex;flex-direction:column;gap:10px">
            <div class="thumb">
              <Img src={e.cover} alt="" ratio="r169" label="" />
              <span class="play" style="width:48px;height:48px" set:html={play(19)}></span>
              {e.duration && <span class="dur">{e.duration}</span>}
            </div>
            <span class="kufi" style="font-weight:700;font-size:16px;line-height:1.6">{e.title}</span>
            <span class="sub" style="font-size:13px">{[MEDIA_TYPES[e.mediaType], e.guest, fmtDate(e.publishedAt)].filter(Boolean).join(' · ')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <div class="wrap article-wrap" style="padding-top:48px">
    <section class="article-main" style="gap:20px">
      <div class="h-sec"><h2 style="font-size:24px">البرامج</h2></div>
      {data.programs.length === 0 && <ComingSoon title="البرامج" />}
      <div class="grid" style="--min:200px;gap:20px">
        {data.programs.map((p) => (
          <div class="box" style="overflow:hidden;display:flex;flex-direction:column">
            <Img src={p.cover} alt="" ratio="r11" label="غلاف البرنامج" style="border-radius:0" />
            <div style="padding:16px;display:flex;flex-direction:column;gap:6px">
              <span class="kufi" style="font-weight:800;font-size:17px">{p.title}</span>
              {p.description && <span style="font-size:14px;color:var(--ink2);line-height:1.7">{p.description}</span>}
              {p.schedule && <span class="meta">{p.schedule}</span>}
            </div>
          </div>
        ))}
      </div>
    </section>
    <section class="article-side" style="max-width:none;flex:1 1 320px;gap:0">
      <div class="h-sec"><h2 style="font-size:24px">النشرة الصوتية</h2></div>
      {audio.map((e) => (
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid var(--line)">
          <a class="play sm" href={`/media/${e.slug}/`} aria-label={`الاستماع: ${e.title}`}><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg></a>
          <div style="flex:1 1 200px;display:flex;flex-direction:column;gap:2px">
            <span class="kufi" style="font-weight:700;font-size:16px">{e.title}</span>
            <span class="meta">{[fmtDate(e.publishedAt), e.duration].filter(Boolean).join(' · ')}</span>
          </div>
          {e.transcript && <a href={`/media/${e.slug}/#transcript`} style="font-size:13px;font-weight:600">النصّ المكتوب</a>}
        </div>
      ))}
    </section>
  </div>
  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('[data-mt]');
      function apply(t) {
        btns.forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-mt') === t); });
        document.querySelectorAll('#eps [data-type]').forEach(function (e) { e.style.display = !t || e.getAttribute('data-type') === t ? '' : 'none'; });
      }
      btns.forEach(function (b) { b.addEventListener('click', function () { apply(b.getAttribute('data-mt')); }); });
      var q = new URLSearchParams(location.search).get('type');
      if (q) apply(q);
    })();
  </script>
</Base>
