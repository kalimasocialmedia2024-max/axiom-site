---
// صفحة القسم: المادّة الأبرز، ثمّ شبكة، ثمّ "الأحدث" مع "تحميل المزيد".
import Img from './Img.astro';
import Row from './Row.astro';
import MostRead from './MostRead.astro';
import Ad from './Ad.astro';
import ComingSoon from './ComingSoon.astro';
import { articleUrl, KINDS, sectionTitle } from '../lib/config.js';
import { imageFirst } from '../lib/sanity.js';
import { fmtDate } from '../lib/format.js';

const { title, description = '', crumb = title, items = [], pills = [], activePill = '' } = Astro.props;
const [lead, ...rest] = imageFirst(items);
const grid = rest.slice(0, 6);
const latest = rest.slice(6);
const tagOf = (a) => (a.kind === 'news' ? sectionTitle(a.section) || 'أخبار' : KINDS[a.kind]?.badge);
---
<section class="page-head">
  <div class="wrap">
    <nav class="crumbs" aria-label="مسار التصفّح"><a href="/">الرئيسية</a><span aria-hidden="true">›</span><span>{crumb}</span></nav>
    <h1>{title}</h1>
    {description && <p>{description}</p>}
    {pills.length > 0 && (
      <div class="pills">
        {pills.map((p) => <a class={`pill${p.href === activePill ? ' on' : ''}`} href={p.href} aria-current={p.href === activePill ? 'page' : undefined}>{p.label}</a>)}
      </div>
    )}
  </div>
</section>
<div class="wrap article-wrap" style="padding-top:32px">
  <main class="article-main" style="gap:36px">
    {!lead && <ComingSoon title={title} />}
    {lead && (
      <article style="display:flex;flex-wrap:wrap;gap:28px;align-items:center">
        <a href={articleUrl(lead)} tabindex="-1" aria-hidden="true" style="flex:3 1 400px"><Img src={lead.image?.url} alt="" ratio="r169" w={1000} label={tagOf(lead)} eager /></a>
        <div style="flex:2 1 260px;display:flex;flex-direction:column;gap:10px">
          <span class="badge">الأبرز</span>
          <h2 class="kufi" style="margin:0;font-weight:800;font-size:28px;line-height:1.55"><a href={articleUrl(lead)}>{lead.title}</a></h2>
          {lead.excerpt && <p style="margin:0;font-size:16px;line-height:1.9;color:var(--ink2)">{lead.excerpt}</p>}
          <span class="meta">{[lead.kind === 'news' ? lead.source : null, fmtDate(lead.publishedAt)].filter(Boolean).join(' · ')}</span>
        </div>
      </article>
    )}
    {grid.length > 0 && (
      <div class="grid" style="--min:240px">
        {grid.map((a) => (
          <article class="card">
            <a href={articleUrl(a)} tabindex="-1" aria-hidden="true"><Img src={a.image?.url} alt="" ratio="r32" w={520} label={tagOf(a)} /></a>
            <div style="display:flex;gap:8px;align-items:center"><span class="tag" style="font-size:12px">{tagOf(a)}</span></div>
            <h3><a href={articleUrl(a)}>{a.title}</a></h3>
            <span class="meta">{fmtDate(a.publishedAt)}</span>
          </article>
        ))}
      </div>
    )}
    {latest.length > 0 && (
      <section style="display:flex;flex-direction:column" id="latest">
        <div class="h-sec"><h2 style="font-size:22px">الأحدث</h2></div>
        {latest.map((a, i) => <Row a={a} extra={i >= 10} />)}
        {latest.length > 10 && <button type="button" class="btn more-btn" data-more="latest">تحميل المزيد</button>}
      </section>
    )}
  </main>
  <aside class="article-side">
    <MostRead />
    <Ad w={300} h={600} />
  </aside>
</div>
