---
import { fmtDate, readingTime } from '../lib/format.js';
const { a } = Astro.props;
---
<div class="byline">
  <div style="display:flex;flex-wrap:wrap;gap:16px">
    {a.authors.map((w) => (
      <a href={`/writers/${w.slug}/`} style="display:flex;align-items:center;gap:12px">
        <div class="avatar" style="width:52px;height:52px">{w.photo ? <img src={`${w.photo}?w=104&h=104&fit=crop`} alt="" /> : 'صورة'}</div>
        <div style="display:flex;flex-direction:column">
          <span class="kufi" style="font-weight:700;font-size:15px">{w.name}</span>
          {w.role && <span class="meta">{w.role}</span>}
        </div>
      </a>
    ))}
  </div>
  <span class="meta">{[fmtDate(a.publishedAt), readingTime(a)].filter(Boolean).join(' · ')}</span>
</div>
